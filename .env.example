# Flask environment: development / production / testing
FLASK_ENV=development

# Secret key for session signing (REQUIRED in production)
SECRET_KEY=dev-secret-key-change-in-production

# Database URL
DATABASE_URL=sqlite:///instance/supermarket.db

# Bootstrap admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Store Administrator

# Server settings
HOST=127.0.0.1
PORT=5000

# Store details
STORE_NAME=SuperMarket
STORE_ADDRESS=
STORE_PHONE=
STORE_EMAIL=
STORE_GSTIN=

# Billing defaults
CURRENCY_SYMBOL=₹
DEFAULT_TAX_RATE=0
DEFAULT_LOW_STOCK_THRESHOLD=10
MAX_BILL_DISCOUNT_PERCENT=100
INVOICE_PREFIX=INV
