# ------------------------------------------------------------------
# SuperMarket Billing System - environment configuration example
# Copy this file to ".env" and adjust the values for your environment.
# NEVER commit the real .env file (it is git-ignored).
# ------------------------------------------------------------------

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
# Generate a strong value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret

# Host / port used by `python app.py`
HOST=127.0.0.1
PORT=5000

# Database -----------------------------------------------------------
# Default: SQLite stored in ./instance/supermarket.db
# For MySQL switch to e.g.:
#   mysql+pymysql://user:password@localhost/supermarket
DATABASE_URL=
# Absolute path override for the SQLite file (optional)
# SUPERMARKET_DB_PATH=

# Store / branding ---------------------------------------------------
STORE_NAME=SuperMarket
STORE_ADDRESS=123 Main Street, Your City
STORE_PHONE=+00 000 000 0000
STORE_EMAIL=contact@example.com
STORE_GSTIN=
CURRENCY_SYMBOL=₹

# Business rules -----------------------------------------------------
# Default tax rate (%) applied to products that do not define their own
DEFAULT_TAX_RATE=0
# Default low-stock threshold for new products
DEFAULT_LOW_STOCK_THRESHOLD=10
# Maximum discount (%) a cashier may apply on an entire bill
MAX_BILL_DISCOUNT_PERCENT=100

# Initial administrator (used by `python manage.py init`) -------------
# Leave ADMIN_PASSWORD empty to have one generated and printed once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_NAME=Store Administrator
